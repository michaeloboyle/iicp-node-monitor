<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Version-scoped compatibility example for older IICP clients. Prefer
     `iicp-node service install`. The official installer already writes an
     absolute iicp-node path. Set the exact cloudflared path only when an older
     installer cannot preserve it. Leaving IICP_TUNNEL unset keeps automatic
     route selection; add IICP_TUNNEL=1 only when a tunnel is intentionally
     forced. Replace __HOME__ and the cloudflared path for the local machine. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>network.iicp.node.default</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>IICP_NODE_NAME</key><string>default</string>
    <key>IICP_SUPERVISED</key><string>1</string>
    <key>IICP_CLOUDFLARED_PATH</key><string>/opt/homebrew/bin/cloudflared</string>
    <key>IICP_TUNNEL_DEAD_POLICY</key><string>auto</string>
    <key>IICP_LOG_DIR</key><string>__HOME__/.iicp/logs</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.cargo/bin/iicp-node</string>
    <string>serve</string>
    <string>--node</string>
    <string>default</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/.iicp/logs/network.iicp.node.default.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.iicp/logs/network.iicp.node.default.err.log</string>
</dict>
</plist>
