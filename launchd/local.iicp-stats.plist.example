<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace __HOME__ with your home dir, e.g. sed "s#__HOME__#$HOME#g".
     Adjust the python3 path if you don't use Homebrew. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.iicp-stats</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__HOME__/.iicp/node-stats-server.py</string>
    <string>--port</string>
    <string>9486</string>
    <string>--host</string>
    <string>127.0.0.1</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/.iicp/logs/iicp-stats.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.iicp/logs/iicp-stats.err.log</string>
</dict>
</plist>
